# Copia este archivo a .env (no se sube a git). Prioridad: argumentos de run.py > variables de entorno > .env > valores por defecto.
# En el mini PC de producción el archivo es C:\ProgramData\recetas-web\config.env (RECETAS_CONFIG_FILE).
# No pongas aquí contraseñas ni claves: las claves de IA se guardan cifradas desde Ajustes.
RECETAS_HOST=0.0.0.0
RECETAS_PORT=8088
# RECETAS_VIDEOS_DIR=D:\recetas\videos
# RECETAS_DATA_DIR=
# RECETAS_SECRET_DIR=
# RECETAS_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# RECETAS_IG_PROVIDER=instaloader
